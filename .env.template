# str-mcp-purview configuration reference. This file is NOT loaded.
#
# The server reads only the process environment. Put these values in your MCP
# host's "env" block or set them as user environment variables. See README
# step 4 and docs/auth.md#auth-environment-variables. The tenant and client IDs
# are not secrets.

AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
# Derived from your sign-in if unset.
PURVIEW_ORGANIZATION=<tenant>.onmicrosoft.com
