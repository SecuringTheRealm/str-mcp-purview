{
  "mcpServers": {
    "purview": {
      "type": "stdio",
      "command": "node",
      "args": ["/absolute/path/to/str-mcp-purview/index.js"],
      "env": {
        "AZURE_TENANT_ID": "<tenant-id>",
        "AZURE_CLIENT_ID": "<client-id>",
        "PURVIEW_ORGANIZATION": "<tenant>.onmicrosoft.com",
        "PURVIEW_TOOL_MODE": "compact"
      }
    }
  }
}
